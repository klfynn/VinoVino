{
  "expo": {
    "name": "VinoVino",
    "slug": "vinovino",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "vinovino",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vinovino.app"
    },
    "android": {
      "package": "com.vinovino.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a0a0f"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "VinoVino benötigt Kamerazugriff zum Scannen von Weinetiketten."
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a0a0f",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
